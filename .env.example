# Embabel Me appliance — copy to `.env` in this directory and edit.
#
#   cp .env.example .env
#
# docker compose reads this file automatically. Nothing here is baked into an
# image; every value is read at container start, so editing it and running
# `docker compose up -d` is enough to apply a change.

# ── Required: at least one model provider ───────────────────────────────────
# The assistant cannot answer without one. OpenAI is the default provider for
# the shipped model configuration; Anthropic is used by the app builder.
OPENAI_API_KEY=
#ANTHROPIC_API_KEY=

# ── The graph engine, and what else an appliance runs on ────────────────────
# Written by setup when it creates an appliance, and by the first `embabel` verb
# on one made before: the engine (EMBABEL for a new appliance, NEO4J for an older
# one), its store, the Neo4j version and password, the embedding model, the
# document converter, the model endpoints and monitoring — each the value this
# appliance already runs on, so a later release cannot move it. The engines do not
# share data: changing GRAPH_TYPE is choosing a different, empty graph. See
# embabel_setup/pins.py for the table and README.md, "Which graph engine".
#GRAPH_TYPE=EMBABEL
#VC_EMBABEL_STORE=sqlite
#NEO4J_VERSION=2026.06-community

# ── Timezone ────────────────────────────────────────────────────────────────
# The containers run UTC unless told otherwise, which makes the assistant's
# clock hours off for most of the planet. setup.py detects your host's zone and
# writes this for you; set it yourself only to override (IANA name).
#TZ=Australia/Sydney

# ── MCP access ──────────────────────────────────────────────────────────────
# You normally do NOT set these: first-run setup (./setup.py) mints an MCP
# bearer token bound to the account you create, and offers to wire Claude Code
# on the spot. Set them here only for scripted deployments that skip the
# wizard (openssl rand -hex 32). A setup-minted token takes precedence.
#EMBABEL_MCP_API_TOKEN=
#EMBABEL_MCP_API_TOKEN_USER=

# ── Authorization fallback ──────────────────────────────────────────────────
# Without an external organization role provider, both appliance modes grant
# every authenticated principal the admin role by default. Set this to `user`
# to opt out; that removes admin access from every authenticated principal.
#ORG_ROLE_FALLBACK=user

# ── Optional: integration credentials ───────────────────────────────────────
# Each unlocks a capability and is inert when empty. Credentials are resolved at
# the integration layer and never injected into a prompt — the assistant can call
# a tool that needs a token without the model ever seeing it.
#BRAVE_API_KEY=            # web search
#GITHUB_TOKEN=             # GitHub realm: issues, PRs, repositories — and cloning PRIVATE
                          # realms/world templates. Usually needs no entry here: setup.py
                          # takes GITHUB_TOKEN / GH_TOKEN / GITHUB_PERSONAL_ACCESS_TOKEN
                          # from your shell, or the gh CLI's token, for that run.
#TELEGRAM_BOT_TOKEN=       # chat with the assistant from Telegram
#SLACK_APP_TOKEN=          # chat with the assistant from Slack

# ── Version ─────────────────────────────────────────────────────────────────
# The appliance tag. Every Embabel image in the compose file moves together;
# unset, they track :latest. Pin this to hold a specific build instead.
#EMBABEL_VERSION=0.2.0

# ── Which build of the appliance itself ─────────────────────────────────────
# The branch or tag this install FOLLOWS. Normally absent, which means main.
#
# Set it to test a branch end to end, exactly as a user would meet it:
#
#   curl -fsSL https://raw.githubusercontent.com/embabel-worlds/appliance/main/install.sh \
#     | EMBABEL_REF=my-branch sh
#
# The installer records it here, so `embabel upgrade` re-reads it and the checkout
# stays on that branch. Delete the line to return to main on the next upgrade.
# EMBABEL_REPO does the same for a fork or an internal mirror.
#EMBABEL_REF=my-branch
#EMBABEL_REPO=embabel-worlds/appliance

# ── World template ──────────────────────────────────────────────────────────
# The git repo NEW worlds are cloned from — how a preconfigured appliance ships
# (an industry world with its realms preinstalled, for example). Normally set
# for you by `./me.py --world <repo>`; applies when a world is FIRST created,
# and never reshapes an existing one.
#ASSISTANT_BOOTSTRAP_WORLD=https://github.com/embabel-worlds/default-world.git

# ── Optional services ───────────────────────────────────────────────────────
# Turn profile-gated services on here rather than passing `--profile` ad hoc:
# compose reconciles to the ACTIVE profile set on every `up`, so an ad-hoc
# profile means the next plain `up` silently stops those containers. It is ONE
# comma-separated list — set every profile you want on the same line.
#
#   openwebui — Open WebUI as an alternative chat front-end on :4245
#
#COMPOSE_PROFILES=openwebui
#
# Prometheus and Grafana, off by default. On, `embabel up` starts them (the
# `monitoring` profile) and holds back their memory in the split.
#EMBABEL_MONITORING=on
# The server's SQL door (the Postgres wire protocol, for BI tools, dbt and notebooks),
# on by default and published on loopback. `./setup.py --no-sql` writes this.
#EMBABEL_SQL=false
#OPEN_WEBUI_SECRET_KEY=
#OPEN_WEBUI_DEFAULT_MODEL=gpt-4.1
# How long Prometheus keeps samples. Costs disk in the prometheus volume.
#PROMETHEUS_RETENTION=15d

# ── Ports (host side) ───────────────────────────────────────────────────────
# All bind to 127.0.0.1, Bolt's two aside — see the security note in README.md before changing.
#ASSISTANT_PORT=4242
#NEO4J_BROWSER_PORT=4243
#NEO4J_BOLT_PORT=4244
#OPEN_WEBUI_PORT=4245
#GRAFANA_PORT=4246
#WORLDS_BOLT_PORT=4248
#WORLDS_PERSISTED_BOLT_PORT=4249
#WORLDS_SQL_PORT=4250
# The Bolt ports are the exception to 127.0.0.1: Neo4j Browser and the drivers dial
# them from other machines, and every session signs in. 127.0.0.1 keeps them local.
#BOLT_BIND=0.0.0.0
# The name those machines dial, which the server advertises and About shows.
# `embabel up` writes it once; change it if this machine is reached by another name.
#BOLT_PUBLIC_HOST=
#PROMETHEUS_PORT=4247

# ── The Worlds console ──────────────────────────────────────────────────────
# The console (4343) asks you to sign in with your appliance account. To skip
# that on a single-user machine, put the same credentials here and its proxy
# authenticates for you. ANYONE who can reach 4343 is then this user — fine on a
# laptop bound to 127.0.0.1, wrong on a shared server.
#WORLDS_CONSOLE_USER=
#WORLDS_CONSOLE_PASSWORD=

# ── The Worlds mode ─────────────────────────────────────────────────────────
# Same image, same data, different front: the world runtime on the 43xx block.
#   docker compose -f docker-compose-worlds.yml up -d
# Run ONE mode at a time — see "Two modes" in README.md.
#WORLDS_PORT=4342
# Externally visible origin for the Worlds mode, if proxied — no trailing slash.
#WORLDS_PUBLIC_BASE_URL=http://localhost:4342

# ── Tuning ──────────────────────────────────────────────────────────────────
# Embedding model. THERE IS A DEFAULT NOW, and this line is how you leave it.
#
# An appliance used to ship unable to embed, so document upload, search and ask
# were off until somebody chose — and an empty value here was passed to the
# container deliberately, to beat the image's own default and keep them off.
#
# The image now carries all-MiniLM-L6-v2 and runs it in process: no key, no
# Docker Model Runner, no download. Unset means the `hosted` ROLE, which
# resolves to that model on an appliance with nothing else, and to a provider's
# own model once a key that can embed arrives. So search works from first boot
# and improves by itself.
#
# Set this only to pin something else:
#
#   embabel embeddings use local    ~1.1GB, Qwen3-Embedding 0.6B via Docker
#                                   Model Runner, nothing leaves this machine
#   embabel embeddings use hosted   the provider key you gave
#   embabel embeddings off          no embedding model at all
#
# Those commands write this line for you, so you rarely set it by hand.
#
# A LOCAL value must be the registry-qualified id the runner reports
# (curl -s localhost:12434/engines/v1/models), not the pull name.
# CHANGING THIS ON AN EXISTING INSTALL is a migration, not a tweak: stored
# vectors were made by the old model, so run the re-embed from
# Settings → Embedding model after switching.
#ASSISTANT_EMBEDDING_MODEL=docker.io/ai/qwen3-embedding:0.6B-F16

# ── Models you run yourself ─────────────────────────────────────────────────
# LM Studio and Ollama running on THIS machine, outside Docker. Both compose
# files already point at the host — `host.docker.internal`, which Docker Desktop
# proxies to your loopback — so a server on its default port needs nothing here.
# Set these only to move a port, or to reach a model server on another box:
#
#   OLLAMA_BASE_URL=http://192.168.1.20:11434
#
# The appliance registers models at BOOT, so one you load afterwards is invisible
# until the next start. `embabel down && embabel up` is enough; your data is
# untouched. Then pick it per job in Models — nothing routes to a local model
# just because it is there.
#LMSTUDIO_BASE_URL=http://host.docker.internal:1234
#OLLAMA_BASE_URL=http://host.docker.internal:11434
# `none` = raw Tika text extraction; makes the (multi-GB) docling image
# unnecessary at the cost of table/figure fidelity in PDFs and office docs.
#ASSISTANT_DOC_CONVERTER=docling
# Docling version, mirrored into GHCR from upstream quay.io (MIT). Pinned so a
# first run cannot be broken by an upstream retag.
#DOCLING_VERSION=v1.29.0
#NEO4J_PASSWORD=embabel-assistant
# Memory. `embabel up` sizes each container from what Docker has; set any of
# these to override its share. Neo4j's heap and page cache follow its limit.
#APP_MEM_LIMIT=3g
#NEO4J_MEM_LIMIT=2g
#DOCLING_MEM_LIMIT=2g
# Docling's workers, and the app's docling requests in flight: derived from docling's
# limit (one per 3.5 GiB, at least one). Each worker holds its own copy of the models.
#DOCLING_WORKERS=1
#NEO4J_HEAP=1G
#NEO4J_PAGECACHE=512M
#JAVA_OPTS=-XX:MaxRAMPercentage=45 -XX:G1PeriodicGCInterval=60000
#MALLOC_ARENA_MAX=2

# ── Usage reporting ─────────────────────────────────────────────────────────
# OFF by default. Your appliance sends Embabel nothing unless you set this.
#
# Turned on, it reports anonymous usage — counts and versions, never your data
# or code — 10 minutes after startup and then every 24 hours. Every field is
# listed in PHONE_HOME.md, and /api/v1/phone-home on your instance shows the
# exact JSON last sent, so you can read it before deciding.
#
# The switch and the collector address both live in this repo, not in the image:
# turning it on is something you do here, not a default you inherit.
#EMBABEL_PHONE_HOME=true

# ── Behind a proxy / on another host ────────────────────────────────────────
# The externally visible origin. OAuth callbacks, MCP resource indicators, and
# app/artifact links all compose from it. No trailing slash.
#ASSISTANT_PUBLIC_BASE_URL=http://localhost:4242

# ── Working on a realm ──────────────────────────────────────────────────────
# The PARENT directory of realm checkouts on this machine, bind-mounted
# read-only at /realms. A world can then load one in place, with no push and no
# clone by the server:
#
#   # config/realms.yml, in the world
#   - name: esg
#     path: /realms/realm-esg
#
# The parent rather than one realm, so adding a realm is a `git clone` rather
# than an edit here and a restart. `./worlds.py` offers to set this on first
# run and checks the path before writing it. The default is the realms/
# directory in this checkout.
#
# macOS: the path must be inside Docker Desktop's file sharing list (Settings →
# Resources → File sharing), or the mount is silently EMPTY. /Users is shared by
# default, so a path under your home directory needs nothing.
#EMBABEL_REALMS_DIR=/Users/you/dev/realms

# ── Which door ───────────────────────────────────────────────────────────────
# The mode this appliance was last started as: `me` (the personal assistant) or
# `worlds` (the world runtime and its console). setup.py writes it the first time
# a mode starts, and `embabel up` with no --me/--worlds returns to it.
#
# It exists because the two defaults disagreed by design — the installer opens
# the Me door, the `embabel` command opens Worlds — so without a record, stopping
# and starting again could hand you the other product on the same graph.
#EMBABEL_MODE=me

# ── Graph connection pool ────────────────────────────────────────────────────
# How many connections the app may hold open to the graph at once. 50 is the
# server's own default, repeated here so it is visible and changeable rather
# than fixed somewhere you cannot reach.
#
# Raise it when requests are being REFUSED under concurrency, not when they are
# merely slow. Measured at 256 concurrent engine runs: at 50, 26 runs were
# refused; at 200, none were — and latency did not improve (p50 3.6s to 3.7s).
# More connections stop the graph turning work away; they do not make it faster,
# so the queue moves from the pool into the database. Note also that a request
# waits a full minute for a connection before it gives up, so a saturated
# appliance reads as slow long before it reads as broken.
#NEO4J_POOL_MAX=50
