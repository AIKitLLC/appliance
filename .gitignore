# Your configuration — holds API keys. Never commit it.
# .envrc is the direnv equivalent and holds exactly the same secrets, so it is
# ignored for exactly the same reason: without this line it is one `git add -A`
# away from being published.
.env
.envrc

# Variants of .env for a second stack on this machine (.env.dialect-verify,
# .env.warehouse-verify, a .env.bak-* taken before a benchmark) hold the same
# keys as .env and are one `git add .` from a public repo. Ignore them by the
# family, not by name, so the next one is covered before anyone remembers to.
.env.*
!.env.example

# Realm credentials, passed into the container wholesale by the optional env_file
# in both compose files. Same blast radius as .env, same rule.
secrets.env

# Which of your folders are shared into the assistant (written by the Me app's
# "Local files" panel). Absolute host paths — this machine's business, like .env.
docker-compose.override.yml

# Realm checkouts you are working on (see realms/README.md). They are their own
# repositories, cloned into the default mount — this repo has no business
# tracking them, and `git add -A` should not swallow somebody's realm.
realms/*
!realms/README.md

# Certificate authorities added with `embabel trust add` (see certs/README.md).
# This machine's trust, not this repo's: somebody's company root has no business
# in a public checkout.
certs/*
!certs/README.md

# Editor and OS noise. An operator clones this repo and runs it; anything their
# tooling drops here is theirs, not ours.
.idea/
*.iml
.vscode/
.DS_Store
__pycache__/
*.pyc

.attest-out/
